# Режим работы. development включает значения по умолчанию для разработки.
# Любое другое значение (и пустое тоже) считается боевым режимом: приложение не стартует
# без SESSION_SECRET, SECRETS_KEY и PUBLIC_BASE_URL. На проде задайте production.
NODE_ENV=development

PORT=3000
DATABASE_URL=postgresql://crito:crito@localhost:5432/crito?schema=public

# Публичный URL API. Попадает в ссылки на файлы внутри страниц: на проде задавайте сразу правильный
# (например, https://cms.example.ru), иначе сохранённые ссылки придётся мигрировать.
PUBLIC_BASE_URL=http://localhost:3000

# Хранилище медиа: local (диск). Относительный путь считается от apps/api, на проде лучше абсолютный.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Авторизация через LMS (пока не используется)
LMS_JWKS_URL=
LMS_ISSUER=
LMS_AUDIENCE=crito-cms
LMS_PERMISSIONS_URL=
LMS_SERVICE_KEY=

# Только NODE_ENV=development. Открывает доступ без входа от имени локального суперпользователя.
AUTH_DEV_BYPASS=false

# Секрет подписи сессий: на проде не короче 32 символов и не change-me.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Ключ шифрования секретов в БД (секрет вебхука сайта): 32 байта в base64 или 64 hex-символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# На проде обязателен; потеря ключа делает сохранённые секреты нечитаемыми.
SECRETS_KEY=
